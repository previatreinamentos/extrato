<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IntelliCreate - Portal do Usuário</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-dark: #0f0f11;
            --card-bg: #18181c;
            --input-bg: #24242a;
            --orange-primary: #ff6600;
            --orange-hover: #e05500;
            --text-light: #f5f5f7;
            --text-muted: #a0a0aa;
            --border-color: #33333d;
            --header-height: 2.8cm; /* Faixa superior cobrindo pelo menos 2cm */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
        }

        body, html {
            width: 100%;
            height: 100%;
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow: hidden;
        }

        /* --- TELA DE LOGIN --- */
        #login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            width: 100vw;
            background: linear-gradient(135deg, rgba(15,15,17,0.95) 0%, rgba(24,24,28,0.98) 100%),
                        radial-gradient(circle at 10% 20%, rgba(255, 102, 0, 0.08) 0%, transparent 40%);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 9999;
        }

        .login-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 40px;
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6),
                        0 0 15px rgba(255, 102, 0, 0.15);
            text-align: center;
        }

        .brand-logo {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 5px;
        }

        .brand-logo span {
            color: var(--orange-primary);
        }

        .brand-subtitle {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-muted);
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            padding: 14px 16px;
            background: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-group input:focus {
            border-color: var(--orange-primary);
        }

        .btn-login {
            width: 100%;
            padding: 14px;
            background-color: var(--orange-primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.1s;
            margin-top: 10px;
        }

        .btn-login:hover {
            background-color: var(--orange-hover);
        }

        .btn-login:active {
            transform: scale(0.99);
        }

        .error-message {
            color: #ff4d4d;
            font-size: 13px;
            margin-top: 15px;
            display: none;
        }

        /* --- TELA PRINCIPAL (APP) --- */
        #app-container {
            display: none;
            width: 100%;
            height: 100%;
            flex-direction: column;
        }

        /* Faixa Personalizada (Superior > 2 cm) */
        .top-banner {
            height: var(--header-height);
            min-height: 2.8cm;
            background: #111114;
            border-bottom: 2px solid var(--orange-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            z-index: 100;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
            position: relative;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-brand h1 {
            font-size: 22px;
            font-weight: 700;
        }

        .header-brand h1 span {
            color: var(--orange-primary);
        }

        .header-tagline {
            font-size: 12px;
            color: var(--text-muted);
            border-left: 1px solid var(--border-color);
            padding-left: 12px;
            display: none;
        }

        @media (min-width: 768px) {
            .header-tagline { display: block; }
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-name {
            font-size: 14px;
            color: var(--text-light);
            font-weight: 600;
        }

        .btn-logout {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-logout:hover {
            border-color: var(--orange-primary);
            color: var(--orange-primary);
        }

        /* Envolvente do iframe que desloca para esconder o aviso padrão do Apps Script */
        .iframe-wrapper {
            flex: 1;
            width: 100%;
            height: calc(100vh - var(--header-height));
            overflow: hidden;
            position: relative;
            background: #ffffff;
        }

        .iframe-wrapper iframe {
            width: 100%;
            height: calc(100% + 42px);
            border: none;
            position: absolute;
            top: -42px; /* Oculta a faixa azul padrão do Google Apps Script */
            left: 0;
        }
    </style>
</head>
<body>

    <!-- PAINEL DE LOGIN -->
    <div id="login-container">
        <div class="login-card">
            <div class="brand-logo">Intelli<span>Create</span></div>
            <div class="brand-subtitle">Educação • Tecnologia • Resultados</div>
            
            <form id="login-form" onsubmit="event.preventDefault(); realizarLogin();">
                <div class="form-group">
                    <label for="username">Usuário</label>
                    <input type="text" id="username" placeholder="Digite seu usuário" required autocomplete="username">
                </div>
                
                <div class="form-group">
                    <label for="password">Senha</label>
                    <input type="password" id="password" placeholder="Digite sua senha" required autocomplete="current-password">
                </div>
                
                <button type="submit" class="btn-login">Acessar Sistema</button>
                <div id="error-msg" class="error-message">Usuário ou senha incorretos!</div>
            </form>
        </div>
    </div>

    <!-- ÁREA DO SISTEMA INCORPORADO -->
    <div id="app-container">
        <!-- Faixa de Cobertura Superior (> 2.5 cm) -->
        <header class="top-banner">
            <div class="header-brand">
                <h1>Intelli<span>Create</span></h1>
                <span class="header-tagline">Conectamos pessoas • Transformamos conhecimento • Geramos resultados</span>
            </div>
            
            <div class="user-info">
                <span class="user-name">Olá, <span id="logged-user-name"></span></span>
                <button class="btn-logout" onclick="realizarLogout()">Sair</button>
            </div>
        </header>

        <!-- Iframe do Web App -->
        <div class="iframe-wrapper">
            <iframe id="app-iframe" src="" allow="autoplay"></iframe>
        </div>
    </div>

    <script>
        // Cadastro de Usuários
        const usuariosValidos = {
            "amauri": { pass: "amauri.intellicreate", name: "Amauri" },
            "bifulco": { pass: "Bifulco.intellicreate", name: "Bifulco" },
            "rolf": { pass: "Rolf.intellicreate", name: "Rolf" }
        };

        const targetURL = "https://script.google.com/macros/s/AKfycbxg3NZfVjfg455W6sJ4ZUrNID2KCR-8KuD3n87DaEXqUo00WSt7001DaZAB4zLAF-hujQ/exec";

        function realizarLogin() {
            const userInput = document.getElementById('username').value.trim();
            const passInput = document.getElementById('password').value.trim();
            const userKey = userInput.toLowerCase();
            const errorMsg = document.getElementById('error-msg');

            if (usuariosValidos[userKey] && usuariosValidos[userKey].pass === passInput) {
                errorMsg.style.display = 'none';
                
                document.getElementById('login-container').style.display = 'none';
                document.getElementById('app-container').style.display = 'flex';
                
                document.getElementById('logged-user-name').innerText = usuariosValidos[userKey].name;
                
                // Carrega o Web App após a autenticação
                document.getElementById('app-iframe').src = targetURL;
            } else {
                errorMsg.style.display = 'block';
            }
        }

        function realizarLogout() {
            document.getElementById('app-container').style.display = 'none';
            document.getElementById('login-container').style.display = 'flex';
            document.getElementById('app-iframe').src = "";
            document.getElementById('username').value = "";
            document.getElementById('password').value = "";
        }
    </script>
</body>
</html>
